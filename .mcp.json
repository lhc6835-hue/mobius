{
  "mcpServers": {
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "claude-code",
        "--project-from-cwd"
      ],
      "env": {}
    },
    "token-savior": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "token-savior-recall[mcp]",
        "token-savior"
      ],
      "env": {}
    },
    "code-review-graph": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "code-review-graph",
        "serve"
      ],
      "env": {}
    }
  }
}